{
  "cli": {
    "version": ">= 19.0.8",
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "environment": "development",
      "channel": "development",
      "env": { "npm_config_legacy_peer_deps": "true" },
      "android": { "buildType": "apk" }
    },
    "staging": {
      "distribution": "internal",
      "environment": "preview",
      "channel": "staging",
      "autoIncrement": true,
      "env": { "npm_config_legacy_peer_deps": "true" },
      "android": { "buildType": "apk" }
    },
    "preview": {
      "extends": "staging",
      "autoIncrement": false
    },
    "production": {
      "distribution": "store",
      "environment": "production",
      "channel": "production",
      "autoIncrement": true,
      "env": { "npm_config_legacy_peer_deps": "true" },
      "android": { "buildType": "app-bundle" }
    }
  },
  "submit": {
    "production": {
      "android": {
        "track": "internal",
        "releaseStatus": "draft"
      }
    }
  }
}
