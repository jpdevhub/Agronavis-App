{
  "name": "agronavis",
  "version": "1.2.0",
  "private": true,
  "description": "Agronavis — AI-driven geospatial intelligence platform for Indian agriculture",
  "license": "UNLICENSED",
  "main": "expo-router/entry",
  "engines": {
    "node": ">=20.0.0",
    "npm": ">=10.0.0"
  },
  "workspaces": [
    "backend",
    "packages/*"
  ],
  "scripts": {
    "dev": "concurrently -n api,app -c green,cyan \"npm:dev:api\" \"npm:dev:app\"",
    "dev:api": "npm run dev --prefix backend",
    "dev:app": "NODE_OPTIONS=--max-old-space-size=4096 expo start",
    "start": "NODE_OPTIONS=--max-old-space-size=4096 expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "NODE_OPTIONS=--max-old-space-size=4096 expo start --web",
    "start:api": "npm run start --prefix backend",
    "build:api": "npm run build --prefix backend",
    "build": "npm run build --workspaces --if-present",
    "build:android": "eas build --platform android",
    "build:ios": "eas build --platform ios",
    "typecheck": "tsc --noEmit && npm run typecheck --workspaces --if-present",
    "lint": "expo lint && npm run lint --workspaces --if-present",
    "lint:fix": "expo lint --fix && npm run lint:fix --workspaces --if-present",
    "test": "jest --passWithNoTests && npm run test --workspaces --if-present",
    "verify": "npm run typecheck && npm run lint && npm run test",
    "format": "prettier --write \"**/*.{ts,tsx,js,json,md,sql}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,json,md,sql}\"",
    "db:link": "supabase link --project-ref $(node -e \"console.log(new URL(process.env.SUPABASE_URL||require('dotenv').config().parsed.SUPABASE_URL).hostname.split('.')[0])\")",
    "db:push": "supabase db push",
    "db:diff": "supabase db diff -f",
    "db:types": "supabase gen types typescript --linked --schema public > packages/shared-types/src/database.types.ts",
    "clean": "rimraf dist .expo \"**/*.tsbuildinfo\" backend/dist coverage",
    "clean:deps": "rimraf node_modules backend/node_modules \"packages/*/node_modules\"",
    "reinstall": "npm run clean:deps && npm install"
  },
  "dependencies": {
    "@agronavis/shared-types": "*",
    "@expo/metro-runtime": "~6.1.2",
    "@expo/vector-icons": "^15.0.2",
    "@hookform/resolvers": "^5.4.0",
    "@react-native-async-storage/async-storage": "^2.2.0",
    "@react-native-community/netinfo": "11.4.1",
    "@react-navigation/bottom-tabs": "^7.4.0",
    "@react-navigation/native": "^7.1.8",
    "@rnmapbox/maps": "^10.3.7",
    "@supabase/supabase-js": "^2.108.1",
    "@tanstack/react-query": "^5.101.0",
    "axios": "^1.12.2",
    "expo": "~54.0.10",
    "expo-build-properties": "~1.0.10",
    "expo-camera": "^17.0.8",
    "expo-clipboard": "~8.0.7",
    "expo-constants": "~18.0.9",
    "expo-device": "~8.0.10",
    "expo-file-system": "~19.0.24",
    "expo-font": "~14.0.8",
    "expo-image": "~3.0.8",
    "expo-image-picker": "^17.0.8",
    "expo-linking": "~8.0.8",
    "expo-localization": "~17.0.9",
    "expo-location": "~19.0.8",
    "expo-notifications": "^0.32.11",
    "expo-router": "~6.0.8",
    "expo-speech": "~14.0.8",
    "expo-speech-recognition": "^3.1.3",
    "expo-splash-screen": "~31.0.10",
    "i18next": "^26.4.2",
    "mapbox-gl": "^2.15.0",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "react-hook-form": "^7.79.0",
    "react-i18next": "^17.0.15",
    "react-native": "0.81.5",
    "react-native-gesture-handler": "~2.28.0",
    "react-native-reanimated": "~4.1.1",
    "react-native-safe-area-context": "~5.6.0",
    "react-native-screens": "~4.16.0",
    "react-native-svg": "15.12.1",
    "react-native-web": "~0.21.0",
    "react-native-worklets": "0.5.1",
    "zod": "^3.25.76",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@types/jest": "^29.5.12",
    "@types/react": "~19.1.0",
    "babel-plugin-module-resolver": "^5.0.2",
    "concurrently": "^9.1.2",
    "dotenv": "^16.4.7",
    "eslint": "^9.25.0",
    "eslint-config-expo": "~10.0.0",
    "jest": "^29.7.0",
    "jest-expo": "~54.0.0",
    "prettier": "^3.4.2",
    "react-native-svg-transformer": "^1.5.3",
    "rimraf": "^6.0.1",
    "supabase": "^2.12.1",
    "typescript": "~5.9.2"
  },
  "overrides": {
    "react-native-svg": "15.12.1",
    "react-native-worklets": "0.5.1"
  },
  "expo": {
    "install": {
      "exclude": [
        "react-native-svg",
        "react-native-worklets"
      ]
    }
  },
  "jest": {
    "preset": "jest-expo",
    "transformIgnorePatterns": [
      "node_modules/(?!((jest-)?react-native|@react-native(-community)?)|expo(nent)?|@expo(nent)?/.*|@expo-google-fonts/.*|react-navigation|@react-navigation/.*|@unimodules/.*|unimodules|sentry-expo|native-base|react-native-svg)"
    ],
    "testPathIgnorePatterns": [
      "/node_modules/",
      "<rootDir>/backend/",
      "<rootDir>/packages/",
      "/\\._"
    ],
    "roots": [
      "<rootDir>/app",
      "<rootDir>/components",
      "<rootDir>/hooks",
      "<rootDir>/services",
      "<rootDir>/features",
      "<rootDir>/store",
      "<rootDir>/utils",
      "<rootDir>/constants",
      "<rootDir>/shared",
      "<rootDir>/modules",
      "<rootDir>/i18n"
    ],
    "modulePathIgnorePatterns": [
      "/\\._"
    ]
  }
}
