# ═════════════════════════════════════════════════════════════════════════════
#  AGRONAVIS — SINGLE ENVIRONMENT FILE
# ═════════════════════════════════════════════════════════════════════════════
#  There is exactly ONE .env in this repository, at the root. Both the backend
#  and the Expo app read it (backend via dotenv, mobile via app.config.js).
#
#  Setup:  cp .env.example .env   then fill in the blanks.
#
#  ┌───────────────────────────────────────────────────────────────────────┐
#  │ EXPO_PUBLIC_* values are EMBEDDED IN THE SHIPPED APP BUNDLE.          │
#  │ Anyone can extract them from the APK. Never put a secret there.       │
#  │ Every secret (service-role key, OpenWeather, Agmarknet, TOTP) lives   │
#  │ un-prefixed and is only ever read by the backend.                     │
#  └───────────────────────────────────────────────────────────────────────┘
# ═════════════════════════════════════════════════════════════════════════════


# ─── 1. SHARED ───────────────────────────────────────────────────────────────
NODE_ENV=development


# ─── 2. BACKEND — SERVER ─────────────────────────────────────────────────────
PORT=3001
API_VERSION=v1
LOG_LEVEL=debug

# Comma-separated list. Expo dev server is :8081, enterprise web will be :3000.
ALLOWED_ORIGINS=http://localhost:8081,http://localhost:3000,http://localhost:19006

RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=300


# ─── 3. SUPABASE ─────────────────────────────────────────────────────────────
# Project URL — Dashboard ▸ Project Settings ▸ Data API
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co

# SECRET. Bypasses Row Level Security. Backend only — never ship to a client.
# Dashboard ▸ Project Settings ▸ API Keys ▸ service_role
SUPABASE_SERVICE_ROLE_KEY=

# Optional. Only needed for projects still issuing legacy HS256 access tokens.
# Newer projects sign with ES256 and are verified via JWKS automatically.
# Dashboard ▸ Project Settings ▸ API ▸ JWT Settings ▸ JWT Secret
SUPABASE_JWT_SECRET=


# ─── 4. BACKEND — THIRD-PARTY APIS (all secrets, backend only) ───────────────
# https://openweathermap.org/api  — free tier, 60 calls/min
OPENWEATHER_API_KEY=

# https://data.gov.in — register free, then subscribe to the Agmarknet resource
AGMARKNET_API_KEY=

# 32+ chars, generated locally — not a third-party credential.
# Encrypts TOTP secrets at rest (AES-256-GCM).
# Generate: openssl rand -base64 48
TOTP_ENCRYPTION_KEY=


# ─── 5. MOBILE (EXPO_PUBLIC_* — PUBLIC, SHIPPED IN THE BUNDLE) ───────────────
# Backend base URL. On a physical device use your machine's LAN IP, not
# localhost — e.g. http://192.168.1.20:3001/api/v1
EXPO_PUBLIC_API_URL=http://localhost:3001/api/v1
EXPO_PUBLIC_API_TIMEOUT=30000

# Same project as SUPABASE_URL above. The anon key is public by design and is
# only used to hold the user's auth session; all data access goes via the API.
EXPO_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=

# Android/iOS Maps SDK key. Restrict it by app signature in Google Cloud.
EXPO_PUBLIC_GOOGLE_MAPS_API_KEY=

# ─── 6. FEATURE FLAGS ────────────────────────────────────────────────────────
EXPO_PUBLIC_ENABLE_SAHAYAK=true
EXPO_PUBLIC_ENABLE_MARKET_PRICES=true
EXPO_PUBLIC_ENABLE_IOT=false
