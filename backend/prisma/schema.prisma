// This is your Prisma schema file for Agronavis
// Learn more: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─── Enums ────────────────────────────────────────────────────────────────────

enum IrrigationType {
  DRIP
  SPRINKLER
  FLOOD
  FURROW
  RAINFED
}

enum SoilType {
  ALLUVIAL
  BLACK_COTTON
  RED_LATERITE
  MOUNTAIN
  DESERT_SANDY
  SALINE
  PEATY
}

enum CropStatus {
  PLANTED
  GROWING
  HARVESTED
  FAILED
}

enum AdvisoryType {
  IRRIGATION
  FERTILIZER
  PEST_CONTROL
  WEATHER_ALERT
  MARKET
  SCHEME
}

enum AdvisoryPriority {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum Language {
  en
  hi
  mr
  pa
  gu
  te
  kn
}

// ─── Models ───────────────────────────────────────────────────────────────────

model Farmer {
  id            String    @id @default(uuid())
  clerkId       String    @unique
  fullName      String
  phone         String    @unique
  state         String
  district      String
  village       String?
  landHolding   Float?    // in acres
  primaryCrops  String[]
  language      Language  @default(en)
  irrigationType IrrigationType?
  soilType      SoilType?
  avatarUrl     String?
  isVerified    Boolean   @default(false)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  farms         Farm[]
  posts         CommunityPost[]
  notifications Notification[]

  @@index([clerkId])
  @@index([state, district])
  @@map("farmers")
}

model Farm {
  id            String    @id @default(uuid())
  farmerId      String
  name          String
  state         String
  district      String
  village       String?
  area          Float     // in acres
  latitude      Float?
  longitude     Float?
  soilType      SoilType?
  irrigationType IrrigationType?
  waterSource   String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  farmer        Farmer    @relation(fields: [farmerId], references: [id], onDelete: Cascade)
  crops         Crop[]
  advisories    Advisory[]

  @@index([farmerId])
  @@map("farms")
}

model Crop {
  id            String     @id @default(uuid())
  farmId        String
  name          String
  variety       String?
  status        CropStatus @default(PLANTED)
  plantedAt     DateTime
  expectedHarvestAt DateTime?
  actualHarvestAt DateTime?
  areaUnderCrop Float?    // in acres
  seedSource    String?
  notes         String?
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt

  farm          Farm       @relation(fields: [farmId], references: [id], onDelete: Cascade)
  scanResults   CropScanResult[]

  @@index([farmId])
  @@map("crops")
}

model CropScanResult {
  id            String   @id @default(uuid())
  cropId        String
  imageUrl      String
  disease       String?
  confidence    Float?
  recommendations String[]
  scannedAt     DateTime @default(now())

  crop          Crop     @relation(fields: [cropId], references: [id], onDelete: Cascade)

  @@index([cropId])
  @@map("crop_scan_results")
}

model Advisory {
  id            String           @id @default(uuid())
  farmId        String
  type          AdvisoryType
  priority      AdvisoryPriority @default(MEDIUM)
  title         String
  content       String
  validFrom     DateTime?
  validUntil    DateTime?
  isRead        Boolean          @default(false)
  source        String?          // 'ai', 'weather', 'manual'
  createdAt     DateTime         @default(now())

  farm          Farm             @relation(fields: [farmId], references: [id], onDelete: Cascade)

  @@index([farmId, isRead])
  @@map("advisories")
}

model CommunityPost {
  id        String   @id @default(uuid())
  farmerId  String
  title     String
  content   String
  imageUrls String[]
  tags      String[]
  likes     Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  farmer    Farmer   @relation(fields: [farmerId], references: [id], onDelete: Cascade)

  @@index([farmerId])
  @@map("community_posts")
}

model Notification {
  id        String   @id @default(uuid())
  farmerId  String
  title     String
  body      String
  type      String
  data      Json?
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())

  farmer    Farmer   @relation(fields: [farmerId], references: [id], onDelete: Cascade)

  @@index([farmerId, isRead])
  @@map("notifications")
}
