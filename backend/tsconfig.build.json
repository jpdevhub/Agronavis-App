{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "noEmit": false,
    "rootDir": "./src",
    "outDir": "./dist",
    "declaration": false,
    "sourceMap": true,
    "paths": {
      "@/*": ["./src/*"],
      "@agronavis/shared-types": ["../packages/shared-types/dist/index.d.ts"]
    }
  },
  "include": ["src/**/*.ts"],
  "exclude": ["tests/**/*", "**/*.test.ts"]
}
