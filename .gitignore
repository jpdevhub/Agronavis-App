# committed.
.expo/
.expo-shared/
/android/
/ios/

# Supabase CLI
supabase/.branches/
supabase/.temp/

# Testing
coverage/
.nyc_output/

# Python / notebooks
__pycache__/
*.py[cod]
.venv/
venv/
.ipynb_checkpoints/

# Data & model artefacts (too large / not source)
notebooks/
*.ipynb
*.pth
*.onnx
# …except the disease classifier, which the API loads at runtime. Render
# deploys what is in the repo, so an ignored model means no scanner in
# production and no error until the first scan.
!backend/model/*.onnx
*.tif
*.tiff

# Secrets
*.pem
*.p8
*.p12
*.keystore
!debug.keystore
agronavis-release.keystore
google-services.json
GoogleService-Info.plist

