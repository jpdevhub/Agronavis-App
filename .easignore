# Reference checkouts — separate repos, never part of a build
krishi-sathi-ai/
KrishiSaathi-AI/

# Regenerated by prebuild on the build server. The leading slash matters:
# a bare `android/` also matches modules/gemma-llm/android/, which is the
# native half of Sahayak — excluding it silently shipped an APK with no model.
/android/
/ios/

# Not part of the app bundle. backend/ and packages/ stay: the root
# package.json declares them as npm workspaces, so npm install needs them.
/notebooks/
/docs/
/.expo/
/backend/dist/
/backend/tests/
# The disease classifier runs on the server. Shipping 43 MB of weights to a
# phone that never loads them would be pure APK weight.
/backend/model/

# Secrets. .easignore REPLACES .gitignore for EAS uploads, so .env has to be
# named here or the service-role key rides along to the build server. The
# EXPO_PUBLIC_* values the app needs are set as EAS environment variables.
.env
.env.*
!.env.example

# This volume writes AppleDouble sidecars beside every file
._*
**/._*
